LOAD FILE=./forcekernel.cpp

UNITS NATURAL

d1: DISTANCE ATOMS=1,2 COMPONENTS

ff: MATHEVAL ...
  ARG=d1.x,d1.y
  PERIODIC=NO
  FUNC=0.2*(-200*exp(-(x-1)^2-10*y^2)-100*exp(-x^2-10*(y-0.5)^2)-170*exp(-6.5*(x+0.5)^2+11*(x+0.5)*(y-1.5)-6.5*(y-1.5)^2)+15*exp(0.7*(x+1)^2+0.6*(x+1)*(y-1)+0.7*(y-1)^2))
...

# --- Apply the potential ---
bb: BIASVALUE ARG=ff

fk: FKERNELABF ...

    ARG=d1.x,d1.y

    # Extended Lagrangian
    KAPPA=3000.0,3000.0    
    TAU=0.5,0.5             
    FRICTION=8.0       
    TEMP=1

    # Kernel representation
    # Non-periodic: GRIDMIN/GRIDMAX required
    GRIDMIN=-1.5,-0.5
    GRIDMAX=1.5,2.5
    SIGMA=0.05,0.05        
    SIGMA_MIN=0.01,0.01 
    PACE=5
    GRIDPACE=1000

    # Boost
    BIASFACTOR=1

    # Output
    CZARSTRIDE=50000
    KERNELINFOSTRIDE=50 
...


PRINT FILE=COLVAR STRIDE=50 ARG=*
